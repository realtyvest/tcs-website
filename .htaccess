RewriteEngine On
# Brief A (Oct 12): old crew-management URLs on www or http go to the final URL in one hop
RewriteCond %{HTTP_HOST} ^www\. [NC,OR]
RewriteCond %{HTTPS} off
RewriteRule ^crew-management(\.html|/)?$ https://telecomcontractorsolutions.com/subcontractor-compliance-tracking.html [R=301,L]
RewriteCond %{HTTP_HOST} ^www\.telecomcontractorsolutions\.com$ [NC]
RewriteRule ^ https://telecomcontractorsolutions.com%{REQUEST_URI} [R=301,L,NE]
RewriteRule ^fit-call$ /fit-call/ [R=301,L]
RewriteRule ^fit-call\.html$ /fit-call/ [R=301,L]
RewriteRule ^book\.html$ /fit-call/ [R=301,L]
# JOB_TO_CASH_ASSESSMENT (2026-10-04): the page lives at /job-to-cash-assessment/index.html.
# The canonical URL has no trailing slash, so serve it there with an internal
# rewrite (200, no redirect). The slash form also serves the page and carries
# the same canonical tag. No slash redirect, so no redirect loop is possible.
RewriteRule ^job-to-cash-assessment$ /job-to-cash-assessment/index.html [L]
RewriteRule ^privacy\.html$ /privacy/ [R=301,L]
RewriteRule ^terms\.html$ /terms/ [R=301,L]
RewriteRule ^tos/?$ /terms/ [R=301,L]
RewriteRule ^faq/?$ /faq.html [R=301,L]
RewriteRule ^pricing/?$ /pricing.html [R=301,L]
RewriteRule ^map-to-invoice/?$ /map-to-invoice.html [R=301,L]
RewriteRule ^cash-flow-calculator/?$ /cash-flow-calculator.html [R=301,L]
RewriteRule ^field-approval-hub/?$ /field-approval-hub.html [R=301,L]
RewriteRule ^sub-invoicing/?$ /sub-invoicing.html [R=301,L]
RewriteRule ^rfp-tracker/?$ /rfp-tracker.html [R=301,L]
RewriteRule ^crew-management\.html$ /subcontractor-compliance-tracking.html [R=301,L]
RewriteRule ^crew-management/?$ /subcontractor-compliance-tracking.html [R=301,L]
RewriteRule ^slack-integration\.html$ /map-to-invoice.html [R=301,L]
RewriteRule ^slack-integration/?$ /map-to-invoice.html [R=301,L]
RewriteRule ^job-costing\.html$ /map-to-invoice.html [R=301,L]
RewriteRule ^job-costing/?$ /map-to-invoice.html [R=301,L]

ErrorDocument 404 /404.html

# Caption tracks must be served with the WebVTT MIME type for consistent
# browser support across native video players.
AddType text/vtt .vtt

# CACHE_POLICY (2026-09-08): pages revalidate on every visit so a push shows up
# on the next load; versioned assets (?v=) cache for a year.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, must-revalidate, max-age=0"
  </FilesMatch>
  <FilesMatch "\.(css|js|png|jpg|jpeg|webp|svg|ico|woff2|mp4|vtt|pdf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# JOB_TO_CASH_ASSESSMENT (2026-10-04): the Assessment webhook config must never
# sit in a year-long browser cache, so this one file revalidates on every visit.
<IfModule mod_headers.c>
  <Files "assessment-config.js">
    Header set Cache-Control "no-cache, must-revalidate, max-age=0"
  </Files>
</IfModule>
